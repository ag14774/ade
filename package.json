{
  "name": "ade",
  "private": true,
  "description": "A terminal agentic development environment: one tab per git worktree, with your editor, coding agent and reviewer wired together",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ag14774/ade.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "zsh tests/run.zsh",
    "check": "tsc -p .",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" && shfmt -w -i 2 -ci starter/link.sh starter/bin/opencode-pane starter/zellij/*.sh"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "solid-js": "^1.9.19",
    "typescript": "^7.0.2"
  }
}
